{
  "name": "vireuikit",
  "version": "0.10.0",
  "description": "A UI kit built on the VireGlass material: atom states, capsule-to-target morphs and web elements.",
  "license": "Apache-2.0",
  "author": "Danil Kotlaev",
  "homepage": "https://github.com/pruffit/vireuikit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pruffit/vireuikit.git"
  },
  "bugs": {
    "url": "https://github.com/pruffit/vireuikit/issues"
  },
  "keywords": [
    "glassmorphism",
    "liquid-glass",
    "vireglass",
    "ui-kit",
    "design-system",
    "material"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.kit.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:english": "node scripts/check-english.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "lab": "vite --config lab/vite.config.ts",
    "check:lab": "playwright test behavior",
    "check:lab:visual": "playwright test visual",
    "check:lab:reference": "node scripts/check-lab-reference.mjs",
    "check:lab:visual:update": "playwright test visual --update-snapshots",
    "check:lab:perf": "playwright test --config playwright.perf.config.ts",
    "check:lab:perf:canaries": "node scripts/check-perf-canaries.mjs"
  },
  "peerDependencies": {
    "vireglass": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "esbuild": "0.27.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vireglass": "^3.4.0",
    "vite": "8.3.2",
    "vitest": "^4.1.11"
  }
}
